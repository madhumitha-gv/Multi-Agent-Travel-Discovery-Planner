# Copy to .env. Never commit real credentials.
GEN_BACKEND=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEN_TIMEOUT=35

# Optional Hugging Face backend; requires available inference credits.
# GEN_BACKEND=huggingface
# HUGGINGFACEHUB_API_TOKEN=your_token_here
GEN_CANDIDATES=auto|Qwen/Qwen3-4B-Instruct-2507,auto|meta-llama/Llama-3.1-8B-Instruct
GEN_TOTAL_TIMEOUT=45

# Single-process demo safeguards; keep max-replicas=1.
SESSION_PLANS_PER_HOUR=5
GLOBAL_PLANS_PER_MINUTE=1
GLOBAL_PLANS_PER_HOUR=10
GLOBAL_PLANS_PER_DAY=10
