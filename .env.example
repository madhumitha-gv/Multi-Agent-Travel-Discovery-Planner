# Copy to .env. Real credentials must never be committed or baked into images.
GEMINI_API_KEY=your_gemini_key_here
HUGGINGFACEHUB_API_TOKEN=your_token_here

# Candidates are tried in order: Gemini, then Hugging Face's auto router.
GEN_CANDIDATES=gemini|gemini-2.5-flash,auto|meta-llama/Llama-3.1-8B-Instruct
GEN_TIMEOUT=20
GEN_TOTAL_TIMEOUT=75

# Each complete guide uses three generate() calls, plus any retries/fallbacks.
# Confirm actual project quotas in AI Studio and adjust these demo caps.
SESSION_PLANS_PER_HOUR=5
GLOBAL_PLANS_PER_MINUTE=1
GLOBAL_PLANS_PER_HOUR=5
GLOBAL_PLANS_PER_DAY=5
